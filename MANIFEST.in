include tools/build_zipapp.py
include LakeCompat.lean LakeCompatMain.lean lakefile.toml lake-manifest.json lean-toolchain
recursive-include LakeCompat *.lean
recursive-include LeanTests *.lean
include examples/upgrade-demo/*.lean examples/upgrade-demo/*.toml examples/upgrade-demo/*.json examples/upgrade-demo/lean-toolchain
